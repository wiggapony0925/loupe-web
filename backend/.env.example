# ── trackify backend — local development env ─────────────────────────────────
# In production these values come from GCP Secret Manager (bound onto Cloud Run
# with `--set-secrets`). This file exists only for local dev. Copy to `.env`.

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Cloud SQL (PostgreSQL). Locally: docker run postgres, or Cloud SQL Auth Proxy.
DATABASE_URL=postgresql://trackify:trackify@localhost:5432/trackify?schema=public

# 32 random bytes, base64 — encrypts Plaid access tokens at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# Firebase project used for Auth (SMS OTP) and FCM push.
FIREBASE_PROJECT_ID=trackify-jfm
# Locally, point GOOGLE_APPLICATION_CREDENTIALS at a service-account key file.
# On Cloud Run, Application Default Credentials are automatic — do not set it.
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-admin.local.json

# Plaid
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Verify the `plaid-verification` JWT on inbound Plaid webhooks (keep on in prod)
PLAID_WEBHOOK_VERIFY=false

# Shared secret appended by the email-forwarding hook (SendGrid Inbound Parse /
# Mailgun route) as ?token=... — rejects spoofed posts to the ingest endpoint.
# Generate: openssl rand -hex 24
EMAIL_WEBHOOK_TOKEN=

# Shared secret for Cloud Scheduler cron endpoints (net-worth snapshots).
CRON_KEY=

# Comma-separated allowlist for browser origins (Capacitor apps send no Origin).
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://app.trackify.jfmcapital.com

# GCS bucket where generated statements are archived (optional locally).
GCS_STATEMENTS_BUCKET=

# When set, boot fetches any missing secret above from GCP Secret Manager in
# this project (useful for local dev against real secrets via ADC).
# SECRET_MANAGER_PROJECT=trackify-jfm
