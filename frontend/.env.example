# Copy to .env.local for development. All values are PUBLIC identifiers
# (Firebase web config is not a secret); real secrets live server-side only.

# Backend origin. Empty in dev = same-origin via the Vite proxy.
VITE_API_URL=

# Firebase web app config (Console → Project settings → Your apps → Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=trackify-jfm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=trackify-jfm
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
